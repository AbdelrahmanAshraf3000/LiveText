# LiveText environment configuration.
# Copy this file to ".env" and adjust as needed. Defaults work out-of-the-box.

POSTGRES_USER=livetext
POSTGRES_PASSWORD=livetext
POSTGRES_DB=livetext

# At least 32 bytes. Change this for any non-local deployment.
JWT_SECRET=dev-default-secret-please-change-me-this-string-must-be-at-least-32-bytes-long

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Seed data: creates 3 demo users (alice, bob, charlie) + sample docs on empty DB
# Demo password for all: password123
SEED_DATA=true
SPRING_PROFILES_ACTIVE=dev

# Redis (pub/sub for cross-instance WebSocket broadcast in production)
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO object storage (image/asset uploads)
# MINIO_ROOT_USER/PASSWORD are the MinIO server credentials; the backend reuses
# them as MINIO_ACCESS_KEY/SECRET_KEY. Change these for any non-local deployment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=livetext-assets
# Browser-reachable MinIO endpoint used for presigned download URLs.
# (The backend talks to MinIO internally at http://minio:9000.)
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
